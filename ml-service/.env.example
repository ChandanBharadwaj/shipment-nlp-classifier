# Copy this file to .env and fill in the values.
# .env is git-ignored — never commit it.

# PostgreSQL connection string
# Docker Compose default (matches docker-compose.yml):
DATABASE_URL=postgresql://shipment:shipment@localhost:5555/shipment_db

# Optional: pre-download the all-MiniLM-L6-v2 model (~90 MB) once and point
# here so the service doesn't need internet access on startup.
# Run once to download: python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"
# Then set the path to where HuggingFace cached it (usually ~/.cache/huggingface/hub).
# SENTENCE_TRANSFORMERS_HOME=C:\Users\YourName\.cache\huggingface\hub
